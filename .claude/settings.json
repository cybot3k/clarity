{
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "SSL_CERT_FILE=/etc/ssl/cert.pem python3 ~/.hackathon-trace/trace_upload.py --agent claude-code",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"c:\\Program Files\\Amoeba\\resources\\app\\amoeba-runtime\\daemon\\dist\\turn-hook.js\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "SSL_CERT_FILE=/etc/ssl/cert.pem python3 ~/.hackathon-trace/trace_upload.py --agent claude-code",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"c:\\Program Files\\Amoeba\\resources\\app\\amoeba-runtime\\daemon\\dist\\prompt-hook.js\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"c:\\Program Files\\Amoeba\\resources\\app\\amoeba-runtime\\daemon\\dist\\pretool-hook.js\"",
            "timeout": 120
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"c:\\Program Files\\Amoeba\\resources\\app\\amoeba-runtime\\daemon\\dist\\posttool-hook.js\""
          }
        ]
      }
    ]
  }
}